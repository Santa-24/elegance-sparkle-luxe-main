# ==============================================================================
# ELEGANCE MAKEOVER & ACADEMY - .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Production & Build Outputs
dist/
dist-ssr/
build/
.output/
.vinxi/
.nitro/
.tanstack/
.vite/
.turbo/
*.tsbuildinfo

# Local Environment Variables & Secrets
.env
.env.*
!.env.example
*.local
.dev.vars
*.pem

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing, Coverage & Audit Artifacts
coverage/
.nyc_output/
.lighthouseci/
lighthouse-report*
*-report.html
*-report.json
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# Cloudflare / Hosting Providers
.wrangler/
.vercel/
.netlify/

# Temporary, Cache & Scratch Files
tmp/
temp/
scratch/
.cache/
.parcel-cache/
*.tmp

# AI / IDE / Editor Specific Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
.gemini/
.claude/
.cursor/
.history/

# OS Generated Files (Windows, macOS, Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Raw / Duplicate Large Media Assets
/Cinematic_luxury_bridal_salon.mp4
